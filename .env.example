# --- Auth ---
AUTH_SECRET=
ADMIN_USERS=

# --- AWS (shared credentials/region for S3 + DynamoDB) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
NEXT_PUBLIC_S3_BASE_URL=

# --- DynamoDB tables ---
# Telemetry/analytics events. Do not store media metadata here.
TELEMETRY_DYNAMODB_TABLE=
TELEMETRY_IP_HASH_SALT=

# Media Library metadata (records created via the admin upload flow).
# Kept in its own table, separate from telemetry, so the two datasets
# can be provisioned/scaled/queried independently. If unset, media
# metadata falls back to an in-memory store that does NOT persist
# across restarts or separate server instances — fine for local
# development only, not for production.
MEDIA_DYNAMODB_TABLE=

# Anonymous visitor sessions + page views (see docs/visitor-tracking-infra.md
# for the exact table + GSI1 to create). If unset, falls back to an
# in-memory store — fine for local dev only, not for production.
VISITOR_DYNAMODB_TABLE=
# How long visitor sessions/page views are retained before TTL-expiring. Default 90.
VISITOR_RETENTION_DAYS=90

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- SES ---
SES_FROM_EMAIL=
SES_TO_EMAIL=
