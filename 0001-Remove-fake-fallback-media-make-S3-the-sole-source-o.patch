From e654921b6aff53ba9a714896eae6093b3e726e17 Mon Sep 17 00:00:00 2001
From: Navneet Pathak <navneet-pathak76@users.noreply.github.com>
Date: Sat, 15 Aug 2026 21:48:30 +0000
Subject: [PATCH] Option A: make S3 the sole, unconditional source of truth for
 galleries
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

getFolderMedia() no longer consults the DynamoDB admin manifest at all.
It was previously checked first and, if it had any published rows,
would short-circuit and skip S3 entirely — which is why gym-content
kept showing 6 stale manifest entries instead of the 17 real videos
sitting in the gym/ S3 folder, even after the prefix mapping was
fixed.

Every project page now always reflects the live S3 bucket directly:
N real objects in the category's real folder -> N cards on the page,
with no manifest layer able to override or mask that count.

lib/media-optimization/content-manifest.ts (listMediaItems) is
untouched and still used by the admin panel's own API route
(app/api/admin/media/route.ts) — this change only removes it from the
public gallery's read path, so the admin dashboard listing itself
still works as before.
---
 lib/aws/get-folder-media.ts | 71 +++++--------------------------------
 1 file changed, 9 insertions(+), 62 deletions(-)

diff --git a/lib/aws/get-folder-media.ts b/lib/aws/get-folder-media.ts
index 44f87b0..01644cb 100644
--- a/lib/aws/get-folder-media.ts
+++ b/lib/aws/get-folder-media.ts
@@ -4,11 +4,7 @@ import {
   ListObjectsV2Command,
   type _Object as S3Object,
 } from "@aws-sdk/client-s3";
-import { listMediaItems } from "@/lib/media-optimization/content-manifest";
-import {
-  PROJECT_OPTIONS,
-  type MediaItemRecord,
-} from "@/lib/media-optimization/media-manifest-types";
+import { PROJECT_OPTIONS } from "@/lib/media-optimization/media-manifest-types";
 import { getS3Client, getS3RuntimeConfig } from "./s3-client";
 
 export type MediaType = "image" | "video";
@@ -128,24 +124,6 @@ function uniquePrefixes(...prefixes: string[]): string[] {
   return [...new Set(prefixes.filter(Boolean))];
 }
 
-function toManifestMediaItem(record: MediaItemRecord): MediaItem {
-  const mediaType: MediaType = record.mediaKind === "video" ? "video" : "image";
-  const thumbnail = mediaType === "image" ? record.cdnUrl : undefined;
-  const video = mediaType === "video" ? record.cdnUrl : undefined;
-
-  return {
-    id: Number(record.displayOrder || 1),
-    title: record.title,
-    thumbnail,
-    video,
-    mediaType,
-    duration: record.durationSeconds ? `${record.durationSeconds}s` : "",
-    category: record.category,
-    client: record.projectTitle,
-    services: record.tags,
-  };
-}
-
 async function listAllObjects(prefix: string): Promise<S3Object[]> {
   const config = getS3RuntimeConfig();
   const s3Client = getS3Client();
@@ -185,19 +163,15 @@ async function listAllObjects(prefix: string): Promise<S3Object[]> {
 }
 
 /**
- * Resolves the gallery for a project, in priority order:
- *
- *  1. PRIMARY   — published admin-managed media from DynamoDB.
- *  2. SECONDARY — a direct listing of the canonical `media/{folder}/`
- *                 (and legacy `videos/{folder}/`) S3 prefixes — the same
- *                 prefixes the admin uploader writes to.
+ * Resolves the gallery for a project by listing the real S3 bucket
+ * directly — the bucket is the single, unconditional source of truth.
  *
- * There is intentionally NO static/fake fallback dataset. S3 (via the
- * manifest, or directly) is the single source of truth for what a project
- * page renders: if S3 has one real video, the page shows one video; if S3
- * has zero, the page shows zero with an explicit empty state. A DynamoDB
- * or S3 failure is logged and treated as "no media found" — it must never
- * be silently upgraded into invented placeholder cards.
+ * There is intentionally NO admin/DynamoDB-manifest priority layer and NO
+ * static/fake fallback dataset: if S3 has one real video, the page shows
+ * one video; if S3 has zero, the page shows zero with an explicit empty
+ * state. An S3 failure is logged and treated as "no media found" — it
+ * must never be silently upgraded into invented or stale placeholder
+ * cards.
  */
 export async function getFolderMedia(
   folder: string,
@@ -208,33 +182,6 @@ export async function getFolderMedia(
   const projectSlug = toProjectSlug(folder);
   const projectFolder = resolveProjectFolder(folder, projectSlug);
 
-  let manifestItems: MediaItemRecord[] = [];
-  try {
-    manifestItems = await listMediaItems({
-      projectSlug,
-      status: "published",
-      sort: "order",
-    });
-  } catch (error) {
-    // A DynamoDB failure here must NOT skip straight to the static
-    // fallback — that bypasses the real S3 listing (step 2) and serves
-    // fully invented placeholder data even when real media exists in
-    // the bucket. Log it and fall through to the S3 listing below,
-    // exactly as if the manifest had simply returned no items.
-    console.warn(`[media] Manifest lookup failed for ${projectSlug}, falling through to direct S3 listing`, error);
-    manifestItems = [];
-  }
-
-  if (manifestItems.length > 0) {
-    return manifestItems.map((item, index) => ({
-      ...toManifestMediaItem(item),
-      id: index + 1,
-      category: meta.category,
-      client: meta.client,
-      services: meta.services, 
-    }));
-  }
-
   // Canonical bucket structure (verified directly against the bucket):
   // categories sit as their own top-level prefixes — `gym/`, `clothing/`,
   // `PRODUCT ADS/`, `AI VIDEOS/`, `logo & graphics/`, `FOOD/`, etc. — with
